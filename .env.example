# Copy to .env and adjust. Never commit the real .env file.

# --- Database ---------------------------------------------------------------
# Docker Compose overrides this to point at the bundled Postgres container.
DATABASE_URL=sqlite:///./dev.db
POSTGRES_PASSWORD=change-me

# --- Public URL used when generating the embed snippet -----------------------
PUBLIC_BASE_URL=http://localhost:8000

# --- Submission limits -------------------------------------------------------
MAX_BODY_BYTES=10240

# --- Rate limiting (token bucket: burst capacity + refill per second) -------
RATE_IP_CAPACITY=10
RATE_IP_REFILL_PER_SEC=2
RATE_WIDGET_CAPACITY=100
RATE_WIDGET_REFILL_PER_SEC=5
# Only true behind a proxy you control (it makes X-Forwarded-For trusted).
TRUST_PROXY=false

# --- Geo enrichment ----------------------------------------------------------
# live = ip-api.com then ipapi.co ; mock = deterministic fake providers
GEO_MODE=live
GEO_TIMEOUT_SECONDS=2

# --- Email side effect -------------------------------------------------------
# console = log the email ; smtp = send via SMTP (e.g. Mailpit on :1025)
EMAIL_BACKEND=console
EMAIL_FROM=widgets@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# --- Background jobs ---------------------------------------------------------
WORKER_ENABLED=true
JOB_MAX_ATTEMPTS=4
JOB_BACKOFF_BASE_SECONDS=2  # retry delay = base ** attempt seconds
WORKER_POLL_SECONDS=1

# --- Caching -----------------------------------------------------------------
CONFIG_CACHE_SECONDS=60
LOADER_CACHE_SECONDS=300

# --- Fault-injection endpoints used to prove resilience (OFF in production) --
ENABLE_DEBUG=false
DEBUG_TOKEN=change-me-debug-token

LOG_LEVEL=INFO
